# ── Auth / CORS ──
# URL pública do frontend (origem permitida no CORS do Spring Security).
# Se precisar permitir várias origens, use CORS_ALLOWED_ORIGINS (ex: http://localhost:3000,https://chatconnect.vercel.app)
FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://seu-front.vercel.app

# JWT (opcional — defaults em application.properties)
# JWT_SECRET=troque_em_producao
# JWT_ACCESS_EXPIRATION=900
# JWT_REFRESH_EXPIRATION=2592000

# Cookies (produção: true + None exige HTTPS)
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAME_SITE=Lax
# AUTH_COOKIE_PATH=/api/auth
