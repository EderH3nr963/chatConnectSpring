@startuml Diagrama_Casos_de_Uso_ChatConnect
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

' Definição dos Atores
actor "Usuário Não Autenticado" as Guest
actor "Usuário Autenticado" as User
actor "Participante do Chat" as Participant
actor "Administrador do Grupo" as Admin
actor "Sistema / Broker" as System << Processo Automático >>

' Especialização/Herança dos Atores
User -up-|> Guest
Participant -up-|> User
Admin -up-|> Participant

rectangle "Sistema ChatConnect" {

    package "Autenticação e Identidade (Clerk)" {
        usecase "UC01 - Sincronizar Cadastro de Usuário\n(RF0011 / RN0025)" as UC01
        usecase "UC02 - Autenticar via Token JWT\n(RF0010 / RN0026)" as UC02
        usecase "UC03 - Sincronizar Alterações Cadastrais\n(RF0012 / RN0025)" as UC03
        usecase "UC04 - Sincronizar Exclusão de Usuário\n(RF0013 / RN0025)" as UC04
    }

    package "Gerenciamento de Chats" {
        usecase "UC05 - Criar Chat Privado\n(RF0001 / RN0002 / RN0018)" as UC05
        usecase "UC06 - Criar Chat em Grupo\n(RF0002 / RN0012)" as UC06
        usecase "UC07 - Consultar Meus Chats\n(RF0008 / RN0011)" as UC07
        usecase "UC08 - Consultar Chat por ID\n(RF0007)" as UC08
        usecase "UC09 - Identificar Role de Participantes\n(RF0009)" as UC09
        usecase "UC10 - Deixar Chat Voluntariamente\n(RF0003)" as UC10
    }

    package "Mensagens e Tempo Real" {
        usecase "UC11 - Enviar Mensagem (REST / STOMP)\n(RF0014 / RN0015 / RN0022)" as UC11
        usecase "UC12 - Editar Própria Mensagem\n(RF0015 / RN0017)" as UC12
        usecase "UC13 - Excluir Mensagem\n(RF0016 / RN0016)" as UC13
        usecase "UC14 - Consultar Histórico de Mensagens\n(RF0017)" as UC14
        usecase "UC15 - Rastrear Presença e Zerar Não Lidas\n(RF0022 / RF0023 / RN0023)" as UC15
    }

    package "Administração do Grupo" {
        usecase "UC16 - Adicionar Participante ao Grupo\n(RF0004 / RN0013 / RN0014)" as UC16
        usecase "UC17 - Remover Participante do Grupo\n(RF0005 / RN0004 / RN0020 / RN0021)" as UC17
        usecase "UC18 - Alterar Informações do Grupo\n(RF0006 / RN0005)" as UC18
        usecase "UC19 - Excluir Chat em Grupo\n(RF0018 / RN0008)" as UC19
    }

    package "Regras e Ações Automáticas" {
        usecase "UC20 - Excluir Chat Vazio e Mensagens\n(RN0009 / RN0010)" as UC20
        usecase "UC21 - Promover Participante Antigo a ADMIN\n(RN0006)" as UC21
        usecase "UC22 - Notificar Mensagem Pendente a Inativos\n(RF0020 / RN0024)" as UC22
    }
}

' Associação de Atores aos Casos de Uso

' 1. Provedor de Identidade / Visitante
Guest --> UC01
Guest --> UC02

' 2. Usuário Autenticado
User --> UC03
User --> UC04
User --> UC05
User --> UC06
User --> UC07
User --> UC08

' 3. Participante do Chat
Participant --> UC09
Participant --> UC10
Participant --> UC11
Participant --> UC12
Participant --> UC13
Participant --> UC14
Participant --> UC15

' 4. Administrador do Grupo
Admin --> UC16
Admin --> UC17
Admin --> UC18
Admin --> UC19
Admin --> UC13

' 5. Sistema / Broker em background
System --> UC20
System --> UC21
System --> UC22

' Relacionamentos de Extensão / Inclusão
UC10 ..> UC21 : <<extend>>\n(se último admin sair)
UC10 ..> UC20 : <<extend>>\n(se chat ficar vazio)
UC19 ..> UC20 : <<include>>\n(remove dados associados)
UC11 ..> UC22 : <<include>>\n(notifica inativos)

@enduml
