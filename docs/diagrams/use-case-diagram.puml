@startuml Diagrama_Casos_de_Uso_ChatConnect
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

' Definição dos Atores
actor "Usuário Não Autenticado" as Guest
actor "Usuário Autenticado" as User
actor "Participante do Chat" as Participant
actor "Administrador do Grupo" as Admin
actor "Sistema" as System << Processo Automático >>

' Especialização/Herança dos Atores
User -up-|> Guest
Participant -up-|> User
Admin -up-|> Participant

rectangle "Sistema ChatConnect" {

    package "Autenticação e Perfil" {
        usecase "UC01 - Cadastrar Usuário\n(RF0011)" as UC01
        usecase "UC02 - Realizar Login\n(RF0010)" as UC02
        usecase "UC03 - Alterar Dados Cadastrais\n(RF0012)" as UC03
    }

    package "Gerenciamento de Chats" {
        usecase "UC04 - Criar Chat Privado\n(RF0001 / RN0002)" as UC04
        usecase "UC05 - Criar Chat em Grupo\n(RF0002 / RN0012)" as UC05
        usecase "UC06 - Consultar Meus Chats\n(RF0008)" as UC06
        usecase "UC07 - Consultar Chat por ID\n(RF0007)" as UC07
        usecase "UC08 - Identificar Role de Participantes\n(RF0009)" as UC08
        usecase "UC09 - Deixar Chat Voluntariamente\n(RF0003)" as UC09
    }

    package "Mensagens" {
        usecase "UC10 - Enviar Mensagem\n(RF0013 / RN0015)" as UC10
        usecase "UC11 - Editar Própria Mensagem\n(RF0014 / RN0017)" as UC11
        usecase "UC12 - Excluir Mensagem\n(RF0014 / RN0016)" as UC12
    }

    package "Administração do Grupo" {
        usecase "UC13 - Adicionar Participante ao Grupo\n(RF0004 / RN0013 / RN0014)" as UC13
        usecase "UC14 - Remover Participante do Grupo\n(RF0005 / RN0004)" as UC14
        usecase "UC15 - Alterar Informações do Grupo\n(RF0006 / RN0005)" as UC15
        usecase "UC16 - Excluir Chat em Grupo\n(RN0008)" as UC16
    }

    package "Regras e Ações Automáticas" {
        usecase "UC17 - Excluir Chat Vazio e Mensagens\n(RN0009 / RN0010)" as UC17
        usecase "UC18 - Promover Participante Antigo a ADMIN\n(RN0006)" as UC18
    }
}

' Associação de Atores aos Casos de Uso

' 1. Usuário Não Autenticado
Guest --> UC01
Guest --> UC02

' 2. Usuário Autenticado
User --> UC03
User --> UC04
User --> UC05
User --> UC06
User --> UC07

' 3. Participante do Chat
Participant --> UC08
Participant --> UC09
Participant --> UC10
Participant --> UC11
Participant --> UC12

' 4. Administrador do Grupo
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC12

' 5. Sistema (Processamento interno / regras de saída)
System --> UC17
System --> UC18

' Relacionamentos de Extensão / Inclusão
UC09 ..> UC18 : <<extend>>\n(se último admin sair)
UC09 ..> UC17 : <<extend>>\n(se chat ficar vazio)
UC16 ..> UC17 : <<include>>\n(remove dados associados)

@enduml
